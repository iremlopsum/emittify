{
  "name": "@iremlopsum/emittify",
  "version": "1.1.0",
  "description": "Tiny event library with caching",
  "keywords": [
    "events",
    "eventemitter",
    "react",
    "typescript",
    "caching"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./mock": {
      "types": "./mock.d.cts",
      "default": "./mock.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "tsc",
    "clean:build": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "release": "release-it",
    "test:dist": "node scripts/smoke-dist.mjs",
    "size": "size-limit",
    "lint:package": "publint --strict --pack npm && attw --pack . --profile esm-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iremlopsum/emittify.git"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "release-it": "^19.0.6",
    "size-limit": "^11.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "mock.cjs",
    "mock.d.cts"
  ],
  "author": "Kristjan Vool",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iremlopsum/emittify/issues"
  },
  "homepage": "https://github.com/iremlopsum/emittify#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "release-it": {
    "git": {
      "commitMessage": "[COLIB] - CHORE - release emittify ${version}",
      "tagName": "${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true
    }
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "900 B"
    },
    {
      "name": "core + react",
      "path": "dist/react/index.js",
      "ignore": [
        "react"
      ],
      "limit": "1.15 kB"
    }
  ],
  "resolutions": {
    "fflate": "0.8.2"
  }
}
